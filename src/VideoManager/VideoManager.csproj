<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VideoManager</AssemblyName>
    <RootNamespace>VideoManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>鲸鱼娘本地媒体管理器</Product>
    <AssemblyTitle>鲸鱼娘的媒体库</AssemblyTitle>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoManager.Core\VideoManager.Core.csproj" />
  </ItemGroup>

</Project>
