<Window x:Class="VideoManager.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="改名"
        Width="440" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="14" Background="#FF101B2D"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.55" Color="#FF000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="给这部作品起个名字" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="只改变媒体库里的显示名，不会动硬盘上的文件。" FontSize="11.5"
                       Foreground="{StaticResource TextFaintBrush}" Margin="0,6,0,14" TextWrapping="Wrap" />
            <TextBox x:Name="TitleBox" FontSize="14" Padding="11,9" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Style="{StaticResource FlatButton}" Click="OnCancel" />
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Click="OnOk" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
