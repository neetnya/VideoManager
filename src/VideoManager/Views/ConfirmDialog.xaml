<Window x:Class="VideoManager.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="460" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="14" Background="#FF101B2D"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.55" Color="#FF000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="HeadlineText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" FontSize="11.5" Margin="0,8,0,0"
                       Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
            <TextBlock FontSize="11.5" Margin="0,10,0,0"
                       Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                       Text="文件会进系统回收站，需要的话还能还原。" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="再想想" Style="{StaticResource FlatButton}" Click="OnCancel" IsCancel="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
