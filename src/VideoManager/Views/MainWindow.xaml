<Window x:Class="VideoManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:VideoManager.ViewModels"
        xmlns:views="clr-namespace:VideoManager.Views"
        xmlns:common="clr-namespace:VideoManager.Common"
        Title="鲸鱼娘的媒体库"
        Width="1360" Height="860"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- 右键菜单不在 Window 的可视树里，RelativeSource 找不到 Window，
             Command 会静默变成 null。用 Freezable 当桥把 DataContext 递进去；
             具体值在 MainWindow 构造函数里灌进去，避免依赖继承时机。 -->
        <common:BindingProxy x:Key="Vm" />

        <!-- 剧集卡片 -->
        <DataTemplate x:Key="SeriesCardTemplate" DataType="{x:Type vm:SeriesCardViewModel}">
            <Border x:Name="Card"
                    Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Margin="0,0,18,20"
                    CornerRadius="14"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnCardClick"
                    Tag="{Binding}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#FF000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 封面 -->
                    <Grid Grid.Row="0"
                          Height="{Binding DataContext.CoverHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border CornerRadius="14,14,0,0" ClipToBounds="True">
                            <Grid>
                                <Border Background="{Binding Title, Converter={StaticResource TitleBrush}}" />
                                <TextBlock Text="{Binding Title, Converter={StaticResource Initials}}"
                                           FontSize="52"
                                           Opacity="0.18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="Bold" />
                                <Image Source="{Binding CoverPath, Converter={StaticResource Img}, ConverterParameter=440}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <Border Background="{StaticResource CoverFade}" />

                                <!-- 未生成封面时的进度提示 -->
                                <Border Visibility="{Binding CoverPending, Converter={StaticResource BoolVis}}"
                                        Background="#AA05090F" CornerRadius="14,14,0,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🐋" FontSize="22" HorizontalAlignment="Center" />
                                        <TextBlock Text="抓封面中…" FontSize="11.5"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   Margin="0,6,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10"
                                        CornerRadius="5" Background="#AA05090F" Padding="7,3"
                                        Visibility="{Binding SeasonLabel, Converter={StaticResource TextVis}}">
                                    <TextBlock Text="{Binding SeasonLabel}" FontSize="10.5"
                                               Foreground="{StaticResource AccentSoftBrush}" />
                                </Border>

                                <Border x:Name="PlayBadge"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Width="44" Height="44" CornerRadius="22"
                                        Background="#CC05090F" Opacity="0"
                                        BorderBrush="#88FFFFFF" BorderThickness="1">
                                    <TextBlock Text="▶" FontSize="16" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="3,0,0,0" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 标题 -->
                    <StackPanel Grid.Row="1" Margin="13,10,13,13">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{Binding DataContext.CardTitleSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="播放"
                                  Command="{Binding Data.PlayFirstCommand, Source={StaticResource Vm}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="查看详情"
                                  Command="{Binding Data.OpenSeriesCommand, Source={StaticResource Vm}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="重新抓这个封面"
                                  Command="{Binding Data.RegenerateCoverCommand, Source={StaticResource Vm}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="换一张封面…"
                                  Command="{Binding Data.SetCoverCommand, Source={StaticResource Vm}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="在资源管理器中打开"
                                  Command="{Binding Data.RevealCommand, Source={StaticResource Vm}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="删到回收站…"
                                  Foreground="{StaticResource WarnBrush}"
                                  Command="{Binding Data.DeleteSeriesCommand, Source={StaticResource Vm}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Border.ContextMenu>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="PlayBadge" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 单集条目 -->
        <DataTemplate x:Key="EpisodeTemplate" DataType="{x:Type vm:EpisodeItemViewModel}">
            <Border x:Name="Row" CornerRadius="9" Padding="11,9" Margin="0,0,0,6"
                    Background="Transparent" Cursor="Hand"
                    MouseLeftButtonUp="OnEpisodeClick"
                    Tag="{Binding}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="播放"
                                  Command="{Binding Data.PlayEpisodeCommand, Source={StaticResource Vm}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="在资源管理器中打开"
                                  Command="{Binding Data.RevealCommand, Source={StaticResource Vm}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="标记已看 / 未看"
                                  Command="{Binding Data.MarkWatchedCommand, Source={StaticResource Vm}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="删到回收站…"
                                  Foreground="{StaticResource WarnBrush}"
                                  Command="{Binding Data.DeleteEpisodeCommand, Source={StaticResource Vm}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="5" Background="#FF16233A"
                            Padding="0,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EpisodeLabel}" FontSize="11.5"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentSoftBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding FileName}" FontSize="10.5"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SizeText}" FontSize="11"
                                   Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WatchedMark}" FontSize="12"
                                   Foreground="{StaticResource OkBrush}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#FF182740" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 路径条目 -->
        <DataTemplate x:Key="RootTemplate" DataType="{x:Type vm:RootItemViewModel}">
            <Border CornerRadius="10" Background="#FF101B2D" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" Padding="14,11" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                              Margin="0,0,12,0" ToolTip="启用 / 停用这个路径" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path}" FontSize="11"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CountText}" FontSize="11.5"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="打开" Style="{StaticResource GhostButton}" FontSize="11.5"
                                Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="✕" Style="{StaticResource GhostButton}" FontSize="11.5"
                                ToolTip="从媒体库移除（不删文件）"
                                Command="{Binding DataContext.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <!-- ZIndex=1：搜索框要往下探出标题栏一点，得盖在下面的主体之上，
                 否则那一截会被主体盖掉。 -->
            <Grid Grid.Row="0" Panel.ZIndex="1" Background="#FF0B1220" MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="🐋" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="鲸鱼娘的媒体库" FontSize="13.5" FontWeight="SemiBold"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 搜索：横跨三列居中，避免因左右两列宽度不等而偏心；
                     整块再往下挪 30px，其他元素位置不变。 -->
                <Grid Grid.Column="0" Grid.ColumnSpan="3" Width="440" Height="34"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="30" />
                    </Grid.RenderTransform>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <TextBlock Text="🔍" FontSize="12" Margin="13,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Foreground="{StaticResource TextFaintBrush}"
                               IsHitTestVisible="False" />
                    <TextBlock Text="搜作品、文件名…" FontSize="12.5" Margin="34,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Foreground="{StaticResource TextFaintBrush}"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource TextVisInvert}}" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Style="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip="最小化" />
                    <Button Content="▢" Style="{StaticResource ChromeButton}" Click="OnMaximize" ToolTip="最大化" />
                    <Button Content="✕" Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- ============ 主体 ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧栏 -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Content="＋ 添加路径"
                                Style="{StaticResource PrimaryButton}"
                                Margin="14,16,14,14"
                                Command="{Binding AddRootCommand}" />

                        <StackPanel Grid.Row="1" Margin="0,4,0,0">
                            <TextBlock Text="媒体库" FontSize="10.5" Margin="22,6,0,6"
                                       Foreground="{StaticResource TextFaintBrush}" />

                            <RadioButton x:Name="NavAll" Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding IsAll, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" CommandParameter="All">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎬" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Text="全部作品" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding IsRecent, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Recent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕘" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Text="最近播放" />
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="管理" FontSize="10.5" Margin="22,16,0,6"
                                       Foreground="{StaticResource TextFaintBrush}" />

                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding IsRoots, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Roots">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Text="媒体库路径" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding IsSettings, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Text="设置" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="14,10,14,16">
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12" />
                            <Button Content="重新扫描"
                                    Style="{StaticResource FlatButton}"
                                    Command="{Binding ScanCommand}"
                                    HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding TotalText}" FontSize="10.5"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       Margin="2,10,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 工具条 -->
                    <Grid Grid.Row="0" Margin="26,18,26,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{Binding CountText}" FontSize="11.5"
                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsLibraryView, Converter={StaticResource BoolVis}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsLibraryView, Converter={StaticResource BoolVis}}">
                            <!-- 排序 -->
                            <Button Style="{StaticResource GhostButton}" Command="{Binding ChangeSortCommand}"
                                    CommandParameter="标题" ToolTip="按标题排序（重复点击切换方向）">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="排序" FontSize="11.5"
                                               Foreground="{StaticResource TextDimBrush}" />
                                    <TextBlock Text="：" FontSize="11.5"
                                               Foreground="{StaticResource TextDimBrush}" />
                                    <TextBlock Text="{Binding SortMode}" FontSize="11.5"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding SortArrow}" FontSize="11.5" Margin="2,0,0,0"
                                               Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding ChangeSortCommand}"
                                    CommandParameter="集数" Content="集数" FontSize="11.5" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding ChangeSortCommand}"
                                    CommandParameter="文件夹" Content="文件夹" FontSize="11.5" />
                            <Border Width="1" Background="{StaticResource LineBrush}" Margin="8,7" />
                            <!-- 卡片大小 -->
                            <Button Style="{StaticResource GhostButton}" Content="小"
                                    Command="{Binding SetCardSizeCommand}" CommandParameter="Small" FontSize="11.5" />
                            <Button Style="{StaticResource GhostButton}" Content="中"
                                    Command="{Binding SetCardSizeCommand}" CommandParameter="Medium" FontSize="11.5" />
                            <Button Style="{StaticResource GhostButton}" Content="大"
                                    Command="{Binding SetCardSizeCommand}" CommandParameter="Large" FontSize="11.5" />
                        </StackPanel>
                    </Grid>

                    <!-- 卡片网格 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,18,20"
                                  Visibility="{Binding IsLibraryView, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding CardsView}"
                                      ItemTemplate="{StaticResource SeriesCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <Grid Grid.Row="1" Visibility="{Binding IsLibraryView, Converter={StaticResource BoolVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VisibleCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="🐋" FontSize="46" HorizontalAlignment="Center" Opacity="0.5" />
                            <TextBlock Text="{Binding EmptyHint}" FontSize="14"
                                       Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock Text="点左下角「添加路径」，把放视频的文件夹拖进来也行～"
                                       FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding IsAll, Converter={StaticResource BoolVis}}" />
                            <Button Content="＋ 添加路径" Style="{StaticResource PrimaryButton}"
                                    Margin="0,20,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding IsAll, Converter={StaticResource BoolVis}}"
                                    Command="{Binding AddRootCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- 路径页 -->
                    <ScrollViewer Grid.Row="1" Padding="26,0,26,20" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsRoots, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="把存放视频的文件夹加进来，扫描时会自动按文件夹名和文件名归类，并从每个作品的第一集里抓封面。"
                                       TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,16" />
                            <ItemsControl ItemsSource="{Binding Roots}" ItemTemplate="{StaticResource RootTemplate}" />
                            <TextBlock Text="还没有添加任何路径" FontSize="12"
                                       Foreground="{StaticResource TextFaintBrush}" Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Roots.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 设置页 -->
                    <ScrollViewer Grid.Row="1" Padding="26,0,26,20" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsSettings, Converter={StaticResource BoolVis}}">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                            <Border CornerRadius="12" Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="封面抓取" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="封面直接从视频里截一帧，同一部剧用第一集的画面。需要 ffmpeg。"
                                               FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                                               TextWrapping="Wrap" Margin="0,6,0,14" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FfmpegPathText, UpdateSourceTrigger=LostFocus}"
                                                 IsReadOnly="False" />
                                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource FlatButton}"
                                                Margin="8,0,0,0" Command="{Binding BrowseFfmpegCommand}" />
                                    </Grid>

                                    <TextBlock Text="{Binding FfmpegStatus}" FontSize="11.5" Margin="2,10,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" />

                                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="封面缓存" FontSize="12.5" />
                                            <TextBlock Text="{Binding CoverCacheInfo}" FontSize="11"
                                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="清空并重抓" Style="{StaticResource FlatButton}"
                                                Command="{Binding ClearCoversCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="12" Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="数据位置" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LibraryPath}" FontSize="11.5"
                                               Foreground="{StaticResource TextDimBrush}"
                                               TextWrapping="Wrap" Margin="0,8,0,12" />
                                    <Button Content="打开文件夹" Style="{StaticResource FlatButton}"
                                            HorizontalAlignment="Left"
                                            Command="{Binding RevealLibraryCommand}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="鲸鱼娘悄悄说：删掉这里的东西只会丢封面和记录，不会动你的视频哦。"
                                       FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                                       TextWrapping="Wrap" Margin="2,16,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 状态栏 -->
                    <Border Grid.Row="2" Background="#FF0C1424" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,1,0,0" Padding="26,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11.5"
                                       Foreground="{StaticResource TextDimBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Width="140" Height="4"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding ProgressValue}"
                                         IsIndeterminate="{Binding IsIndeterminate}"
                                         Background="#FF16233A" Foreground="{StaticResource AccentBrush}"
                                         BorderThickness="0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                                         VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ 详情抽屉 ============ -->
                <Grid Grid.Column="1" x:Name="DetailLayer"
                      Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolVis}}">
                    <Border Background="#B3050910" MouseLeftButtonDown="OnDetailBackdropClick" />

                    <Border x:Name="DetailPanel"
                            Width="470" HorizontalAlignment="Right"
                            Background="#FF0E1728"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="-6" Opacity="0.5" Color="#FF000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 头部 -->
                            <Grid Grid.Row="0">
                                <Grid.Height>255</Grid.Height>
                                <Border CornerRadius="0" ClipToBounds="True">
                                    <Grid>
                                        <Border Background="{Binding SelectedTitle, Converter={StaticResource TitleBrush}}" />
                                        <Image Source="{Binding SelectedCoverPath, Converter={StaticResource Img}, ConverterParameter=900}"
                                               Stretch="UniformToFill" />
                                        <Border Background="{StaticResource CoverFade}" />
                                    </Grid>
                                </Border>

                                <Button Content="✕" Style="{StaticResource GhostButton}" FontSize="14"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,10,10,0" Command="{Binding CloseDetailCommand}" />

                                <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,16">
                                    <TextBlock x:Name="DetailTitle" Text="{Binding SelectedTitle}"
                                               FontSize="21" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               Background="Transparent" Cursor="Hand"
                                               MouseLeftButtonDown="OnTitleDoubleClick"
                                               ToolTip="双击可以改名" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding SelectedCountText}" FontSize="11.5"
                                                   Foreground="{StaticResource AccentSoftBrush}" />
                                        <TextBlock Text="{Binding SelectedSeasonLabel}" FontSize="11.5"
                                                   Foreground="{StaticResource TextDimBrush}" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedFolder}" FontSize="10.5"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <!-- 操作 -->
                            <StackPanel Grid.Row="0" VerticalAlignment="Bottom" Margin="20,0,20,-26"
                                        Orientation="Horizontal">
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="20,4,20,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="▶ 播放" Style="{StaticResource PrimaryButton}"
                                                Padding="20,8" Command="{Binding PlayFirstCommand}" />
                                        <Button Content="换封面" Style="{StaticResource FlatButton}"
                                                Margin="8,0,0,0" Command="{Binding SetCoverCommand}"
                                                CommandParameter="{Binding SelectedCard}" />
                                        <Button Content="重抓" Style="{StaticResource FlatButton}"
                                                Margin="8,0,0,0" Command="{Binding RegenerateCoverCommand}"
                                                CommandParameter="{Binding SelectedCard}" />
                                        <Button Content="📁" Style="{StaticResource FlatButton}"
                                                Margin="8,0,0,0" ToolTip="在资源管理器中打开"
                                                Command="{Binding RevealCommand}"
                                                CommandParameter="{Binding SelectedCard}" />
                                        <Button Content="🗑" Style="{StaticResource FlatButton}"
                                                Margin="8,0,0,0" Foreground="{StaticResource WarnBrush}"
                                                ToolTip="把这一部的视频文件删到回收站"
                                                Command="{Binding DeleteSeriesCommand}"
                                                CommandParameter="{Binding SelectedCard}" />
                                    </StackPanel>
                                    <TextBlock Text="双击标题可改名 · 播放不会自动标记，看完点右侧 ✓ 记一笔"
                                               FontSize="10.5" Foreground="{StaticResource TextFaintBrush}"
                                               Margin="2,10,0,0" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0,10,18">
                                    <ItemsControl ItemsSource="{Binding Episodes}"
                                                  ItemTemplate="{StaticResource EpisodeTemplate}" />
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
